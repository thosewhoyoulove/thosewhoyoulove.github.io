PORT=8787
COPILOT_MODE=mock
# Cursor Agent mode (server only; account/model access must be verified):
# COPILOT_MODE=cursor
# CURSOR_API_KEY=your-cursor-user-api-key
# CURSOR_MODEL=composer-2.5
# In real mode, set these only on the Node server:
# COPILOT_MODE=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-provider-server-side-key
# LLM_MODEL=your-provider-tool-calling-model
# Base URL includes the API prefix, without /chat/completions.
# Legacy OPENAI_API_KEY/OPENAI_MODEL work when LLM_BASE_URL is unset.
# Allowed site origin for a separately hosted API:
# COPILOT_ORIGIN=https://thosewhoyoulove.github.io
# Public API URL for the widget build; leave blank for same-origin hosting:
# VITE_COPILOT_API_URL=
