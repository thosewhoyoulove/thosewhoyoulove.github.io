{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "docs",
  "functions": {
    "api/copilot/chat.ts": {
      "includeFiles": "docs/md/**",
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/copilot/health.ts": {
      "includeFiles": "docs/md/**"
    }
  }
}
